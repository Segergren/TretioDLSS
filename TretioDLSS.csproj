<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Solution builds set Platform=x64; keep one output folder for them, F5 and the tools. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TretioDLSS</RootNamespace>
    <AssemblyName>TretioDLSS</AssemblyName>
    <Product>TretioDLSS</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416;WFO0003</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);Frontend\**;Tests\**;ThirdParty\**;TestMedia\**;tools\**;publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="PhotinoX" Version="5.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="FlashCap" Version="1.13.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TretioDLSS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\**\*.hlsl;Shaders\**\*.hlsli;Shaders\**\*.h" LogicalName="Shaders/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="Resources\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <FrontendSourceFiles Include="Frontend\src\**\*;Frontend\public\**\*;Frontend\index.html;Frontend\package.json;Frontend\vite.config.ts;Frontend\tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildFrontendAssets" BeforeTargets="_CalculateEmbeddedFilesManifestInputs" Inputs="@(FrontendSourceFiles)" Outputs="Resources\wwwroot\index.html" Condition="'$(SkipFrontend)' != 'true'">
    <Exec WorkingDirectory="Frontend" Command="npm ci" Condition="!Exists('Frontend\node_modules')" />
    <Exec WorkingDirectory="Frontend" Command="npm run build" />
    <ItemGroup>
      <OldFrontendFiles Include="Resources\wwwroot\**\*" />
      <FrontendDistFiles Include="Frontend\dist\**\*" />
    </ItemGroup>
    <Delete Files="@(OldFrontendFiles)" />
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="@(FrontendDistFiles->'Resources\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="IncludeFrontendAssets" BeforeTargets="_CalculateEmbeddedFilesManifestInputs" AfterTargets="BuildFrontendAssets">
    <ItemGroup>
      <EmbeddedResource Include="Resources\wwwroot\**\*" WithCulture="false" />
    </ItemGroup>
  </Target>

  <!-- DLSS Frame Generation: the native NGX bridge and NVIDIA's runtime, when ThirdParty/dlss is fetched (tools/dlss/fetch.ps1). -->
  <ItemGroup>
    <TretioNgxSources Include="Native\TretioNgx\*.cpp;Native\TretioNgx\*.h;Native\TretioNgx\build.ps1" />
  </ItemGroup>

  <Target Name="BuildTretioNgx" Condition="Exists('ThirdParty\dlss\lib\nvsdk_ngx_s.lib')" Inputs="@(TretioNgxSources)" Outputs="Native\build\TretioNgx.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File Native\TretioNgx\build.ps1" />
  </Target>

  <Target Name="IncludeTretioNgx" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildTretioNgx">
    <ItemGroup>
      <None Include="Native\build\TretioNgx.dll" Condition="Exists('Native\build\TretioNgx.dll')" Link="TretioNgx.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="ThirdParty\dlss\bin\nvngx_dlssg.dll" Condition="Exists('ThirdParty\dlss\bin\nvngx_dlssg.dll')" Link="nvngx_dlssg.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- DirectML's debug layer comes with its package but is only for driver debugging. -->
  <Target Name="DropDirectMLDebug" AfterTargets="Build;Publish">
    <Delete Files="$(OutDir)DirectML.Debug.dll;$(OutDir)DirectML.Debug.pdb" />
    <Delete Files="$(PublishDir)DirectML.Debug.dll;$(PublishDir)DirectML.Debug.pdb" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
